source("C:/Users/adolf/Dropbox/Work/2024_Actual_papers/2026_Baltic_Ecosystem_Hysteresis/Analysis_Figures/ODIN_extract_EGB_DIN_DIP_202608_31.R")
# ------------------------------------------------------------------------------
# 9. OVERLAY MODEL DATA (BLUE2) ON OBSERVATIONAL PLOT
# ------------------------------------------------------------------------------
# Load the Blue2 model data from the causal input CSV
df_model <- read.csv("Baltic_variables_Mt_4_Causal_Input.csv") %>%
filter(Year >= 1969 & Year <= 2022) %>%
# Rename columns so they map to the exact same facet panels as the ODIN data
select(Year, Nitrate = DIN_DEEP, Phosphate = DIP_DEEP) %>%
pivot_longer(
cols = -Year,
names_to = "Nutrient",
values_to = "Model_Value"
)
# Append the model data to the existing ggplot object
plot_egb_combined <- plot_egb +
geom_line(
data = df_model,
aes(x = Year, y = Model_Value),
color = "grey20",          # Dark grey to contrast with the colored observations
linetype = "dashed",       # Distinct dashed pattern
linewidth = 1.2,
inherit.aes = FALSE        # Ignore the color/fill mappings from df_long
) +
labs(
title = "Eastern Gotland Basin: Observations vs. Blue2 Model",
subtitle = "Annual Mean 0-10m Concentration (Solid/Ribbon = ODIN Obs | Dashed = Blue2 Model)"
)
print(plot_egb_combined)
# Export the combined plot
ggsave(
filename = "EGB_Obs_vs_Model_Nutrients_1969_2022.png",
plot = plot_egb_combined,
width = 10,
height = 8,
units = "in",
dpi = 300,
bg = "white"
)
# ------------------------------------------------------------------------------
# 10. STATISTICAL EVALUATION: MODEL VS. OBSERVATIONS
# ------------------------------------------------------------------------------
# 1. Prepare a wide-format subset of the model data
df_model_wide <- read.csv("Baltic_variables_Mt_4_Causal_Input.csv") %>%
filter(Year >= 1969 & Year <= 2022) %>%
select(Year, Model_Nitrate = DIN_DEEP, Model_Phosphate = DIP_DEEP)
# 2. Merge model data with the observational annual means
df_eval <- merge(annual_summary, df_model_wide, by = "Year") %>%
# Drop any rows where either observations or model data might be NA
drop_na(Nitrate_mean, Model_Nitrate, Phosphate_mean, Model_Phosphate)
# 3. Calculate Evaluation Metrics (Pearson r, RMSE, Bias)
eval_metrics <- data.frame(
Nutrient = c("Nitrate", "Phosphate"),
# Pearson Correlation
Pearson_r = c(
cor(df_eval$Nitrate_mean, df_eval$Model_Nitrate, method = "pearson"),
cor(df_eval$Phosphate_mean, df_eval$Model_Phosphate, method = "pearson")
),
# Root Mean Square Error (RMSE)
RMSE = c(
sqrt(mean((df_eval$Nitrate_mean - df_eval$Model_Nitrate)^2)),
sqrt(mean((df_eval$Phosphate_mean - df_eval$Model_Phosphate)^2))
),
# Mean Bias (Model - Obs: positive means model overestimates)
Mean_Bias = c(
mean(df_eval$Model_Nitrate - df_eval$Nitrate_mean),
mean(df_eval$Model_Phosphate - df_eval$Phosphate_mean)
)
)
# Round the metrics for a clean output
eval_metrics <- eval_metrics %>%
mutate(across(where(is.numeric), ~round(., 3)))
print("--- Model vs. Observation Statistical Skill ---")
print(eval_metrics)
# Optional: Save the metrics to a CSV
write.csv(eval_metrics, "EGB_Model_Skill_Metrics.csv", row.names = FALSE)
