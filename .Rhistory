View(vertical_means)
View(annual_summary)
plot(annual_summary$Nitrate)
lines(annual_summary$Phosphate*2,col=2)
lines(annual_summary$Phosphate*5,col=2)
lines(annual_summary$Nitrate,col=4)
library(ggplot2)
library(dplyr)
library(tidyr)
library(ggpubr)
# 1. Filter the dataset to 1969-2022 and rename columns for clean pivoting
df_plot <- annual_summary %>%
filter(Year >= 1969 & Year <= 2022) %>%
rename(Nitrate_mean = Nitrate, Phosphate_mean = Phosphate) %>%
select(Year, Nitrate_mean, Nitrate_rms, Phosphate_mean, Phosphate_rms)
# 2. Pivot to long format so we can facet the plot
df_long <- df_plot %>%
pivot_longer(
cols = -Year,
names_to = c("Nutrient", ".value"),
names_sep = "_"
)
# 3. Calculate the 95% Confidence Intervals
# (mean +/- 1.96 * Standard Error)
df_long <- df_long %>%
mutate(
CI_lower = mean - 1.96 * rms,
CI_upper = mean + 1.96 * rms
)
# 4. Define Okabe-Ito colors matching your Figure 5 Network
okabe_ito_obs <- c("Nitrate" = "#F0E442",   # Yellow (matching DIN)
"Phosphate" = "#009E73") # Bluish-Green (matching DIP)
# 5. Generate the Plot
plot_obs <- ggplot(df_long, aes(x = Year, y = mean, color = Nutrient, fill = Nutrient)) +
# Add the 95% CI ribbon (transparent so grid lines show through)
geom_ribbon(aes(ymin = CI_lower, ymax = CI_upper), alpha = 0.3, color = NA) +
# Add lines and points
geom_line(linewidth = 1) +
geom_point(size = 2.5, shape = 21, color = "black", stroke = 0.5) +
# Facet the plot to give each nutrient its own y-axis scale
facet_wrap(~ Nutrient, scales = "free_y", ncol = 1) +
scale_color_manual(values = okabe_ito_obs) +
scale_fill_manual(values = okabe_ito_obs) +
scale_x_continuous(breaks = seq(1970, 2020, by = 10)) +
# Harmonized Theme
theme_pubr(base_size = 14) +
labs(
title = "Arkona Basin Observational Data (1969 - 2022)",
subtitle = "Annual Mean Nitrate and Phosphate (0-10m) with 95% Confidence Intervals",
x = "Year",
y = expression(paste("Concentration (mmol / ", m^3, ")"))
) +
theme(
legend.position = "none",
plot.title = element_text(face = "bold", size = 16),
strip.text = element_text(face = "bold", size = 14),
strip.background = element_rect(fill = "grey95", color = NA),
plot.margin = margin(t = 0.5, r = 1, b = 0.5, l = 0.5, unit = "cm")
)
print(plot_obs)
# Export the plot
ggsave(
filename = "Arkona_Obs_Nutrients_1969_2022.png",
plot = plot_obs,
width = 10,
height = 8,
units = "in",
dpi = 300,
bg = "white"
)
